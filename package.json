{
  "name": "gyros-tou-kosmou",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "probe:offline": "node tools/offline_probe.mjs",
    "test:reactions": "node --import ./scripts/register_ts.mjs scripts/reactionsTest.ts",
    "probe:balls": "node tools/balls_probe.mjs",
    "probe:fix-round": "node tools/fix_round_probe.mjs",
    "test:engine": "node --import ./scripts/register_ts.mjs scripts/engineTest.ts",
    "test:data": "node --import ./scripts/register_ts.mjs scripts/validate.ts",
    "audit:dist": "node tools/audit_dist.mjs",
    "probe:modes": "node tools/modes_probe.mjs && node tools/geo_modes_probe.mjs && node tools/identity_probe.mjs",
    "test:markup": "node tools/modes_markup_test.mjs",
    "gen:borders": "node --import ./scripts/register_ts.mjs scripts/genBorders.ts"
  },
  "dependencies": {
    "@types/d3-transition": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "flag-icons": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
