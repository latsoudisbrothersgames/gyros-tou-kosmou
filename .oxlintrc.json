{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "useSettings",
          "useReactions",
          "parseGameConfig",
          "scratchBasePoints",
          "COVER_KINDS",
          "COVER_LABELS",
          "hasLandmarkArt",
          "projectToMap"
        ]
      }
    ]
  }
}
